{
  "name": "mortgage-simulator",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "yarn lint:eslint && yarn lint:stylelint",
    "lint:eslint": "eslint . --cache",
    "lint:stylelint": "stylelint '**/*.css' --cache",
    "prettier": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "fix": "yarn prettier:write && eslint . --cache --fix && stylelint '**/*.css' --cache --fix",
    "verify": "yarn fix && yarn typecheck",
    "vitest": "vitest run",
    "vitest:watch": "vitest",
    "vitest:changed": "vitest run --changed",
    "vitest:related": "vitest related --run",
    "test": "yarn typecheck && yarn prettier && yarn lint && yarn vitest && yarn build",
    "postinstall": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "dependencies": {
    "@mantine/charts": "^9.4.1",
    "@mantine/core": "^9.4.1",
    "@mantine/dates": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@mantine/notifications": "^9.4.1",
    "@tabler/icons-react": "^3.44.0",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "react-is": "^19.2.7",
    "recharts": "^3.9.2",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-config-mantine": "^4.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.19",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.3.5",
    "vitest": "4.1.12"
  },
  "resolutions": {
    "@babel/runtime": "^7.26.10",
    "@humanfs/node": "^0.16.8",
    "baseline-browser-mapping": "^2.11.34",
    "brace-expansion": "^5.0.12",
    "braces": "^3.0.3",
    "browserslist": "^4.29.5",
    "colord": "^2.9.7",
    "cross-spawn": "^7.0.5",
    "fast-uri": "^3.1.9",
    "flatted": "^3.4.2",
    "form-data": "^4.0.6",
    "glob": "^11.1.0",
    "ip-address": "^10.7.5",
    "js-cookie": "^3.0.5",
    "js-yaml": "^4.3.2",
    "micromatch": "^4.0.8",
    "minimatch": "^10.2.6",
    "moment": "^2.31.0",
    "nanoid": "^3.3.18",
    "picomatch": "^4.0.4",
    "postcss-selector-parser": "^7.1.7",
    "serialize-javascript": "^7.1.4",
    "source-map-js": "^1.2.2",
    "tar": "^7.5.21",
    "undici": "^7.30.1",
    "vite": "^8.3.5",
    "ws": "^8.18.0",
    "zod": "^4.6.6"
  },
  "packageManager": "yarn@4.2.2"
}
